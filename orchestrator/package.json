{
  "name": "xramp-orchestrator",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create xramp-orchestrator-db",
    "db:migrate": "wrangler d1 execute xramp-orchestrator-db --file=./schema.sql",
    "db:migrate:local": "wrangler d1 execute xramp-orchestrator-db --local --file=./schema.sql",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "ethers": "^6.13.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241018.0",
    "typescript": "^5.8.3",
    "wrangler": "^3.80.0"
  }
}
